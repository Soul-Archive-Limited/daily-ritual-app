{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/theme/tokens": [
        "./src/shims/tokens.ts"
      ],
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "src",
    "../src/logic",
    "../src/db/types.ts"
  ]
}
